<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_widget_card">

    <!-- Top Header Row: #81 McLaren Badge + F1 Countdown -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_f1_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="#81 PIASTRI // AAYUSH OS"
            android:textColor="#FF8000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_mode_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="90HZ READY"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Live Hardware Telemetry Readout -->
    <TextView
        android:id="@+id/widget_telemetry_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="⚡ 5.1W (82%) • 35.0°C • RAM 68%"
        android:textColor="#F5F5F5"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:singleLine="true" />

    <!-- F1 Race Schedule / French Press Timer Status -->
    <TextView
        android:id="@+id/widget_sub_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="🏎️ Next GP • Tap buttons below for quick actions"
        android:textColor="#9E9E9E"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:singleLine="true" />

    <!-- Interactive 4-Button Quick Action Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_btn_coffee"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:gravity="center"
            android:background="@drawable/bg_widget_pill"
            android:text="☕ 4:00"
            android:textColor="#FF8000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/widget_btn_nowbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:gravity="center"
            android:background="@drawable/bg_widget_pill"
            android:text="⚡ ISLAND"
            android:textColor="#F5F5F5"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/widget_btn_coding"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:gravity="center"
            android:background="@drawable/bg_widget_pill"
            android:text="💻 CODE"
            android:textColor="#F5F5F5"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:gravity="center"
            android:background="@drawable/bg_widget_pill"
            android:text="🔄 SYNC"
            android:textColor="#00E676"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

</LinearLayout>
